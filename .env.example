# Server Configuration (Safe defaults allow immediate startup)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=INFO
MAX_PAYLOAD_SIZE=256kb

# Redis Configuration (Optional in preview mode; required for distributed BullMQ processing)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_NAME=webhook-dispatcher
MAX_RETRIES=3
INITIAL_BACKOFF_MS=1000

# Webhook Delivery Settings
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-key-32chars-min

# Per-Destination Rate Limiting
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=2

# PostgreSQL Database Configuration (Optional in preview mode; required for audit log persistence)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=webhook_dispatcher
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_TIMEOUT_MS=3000

# Security (SSRF protection: keep false in production)
ALLOW_LOCAL_DESTINATIONS=false
